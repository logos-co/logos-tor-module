  "include": [],
  "capabilities": [],
  "codegen": {
    "rust": { "crate": "rust-lib", "trait": "TorModule", "source": "src/glue.rs" }
  },
  "nix": {
    "rust": {
      "toolchain": "1.96.0",
      "packages": { "build": [], "runtime": [] }
    },
    "external_libraries": [],
    "packages": { "build": [], "runtime": [] },
    "cmake": { "find_packages": [], "extra_include_dirs": [] }
  }
}
